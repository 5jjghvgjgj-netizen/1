{
  "name": "1",
  "version": "0.1.0",
  "private": true,
  "description": "项目仓库（Node.js + TypeScript 骨架）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc",
